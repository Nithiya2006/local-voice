# ==============================================================================
# LocalVoice - Backend Server Environment Configuration
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Atlas Database Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/localvoice
# Production MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/localvoice?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/localvoice

# JSON Web Token Secret (generate a strong random string in production)
JWT_SECRET=localvoice_jwt_super_secret_key_2026_community_civic_platform

# Frontend Client URL (Deployed Vercel URL for CORS)
# Example: https://local-voice.vercel.app
CLIENT_URL=http://localhost:5173

# Optional: Cloudinary Configuration (For persistent image hosting in production)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
